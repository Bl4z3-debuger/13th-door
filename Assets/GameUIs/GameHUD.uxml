<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://w3.org" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/GameStyles.uss?fileID=7433441132597879392&amp;guid=1059d50aa3a7a3340a638d5e66f2dc0b&amp;type=3#GameStyles"/>
    <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; justify-content: center; align-items: center;">
        <ui:VisualElement name="NotepadPanel" style="width: 50%; height: 85%; justify-content: center; align-items: center; position: relative; background-image: url(&quot;project://database/Assets/GameUIs/pixil-frame-0%20(3).png?fileID=2800000&amp;guid=fed16cd4c201b46418c628352188852e&amp;type=3#pixil-frame-0 (3)&quot;); align-self: center; flex-shrink: 1; flex-grow: 0; display: none;"/>
        <ui:Button text="" name="NotepadButton" style="position: absolute; bottom: 20px; right: 20px; width: 288px; height: 302px; -unity-text-outline-color: rgba(0, 0, 0, 0); color: rgba(27, 27, 27, 0); border-left-color: rgba(55, 55, 55, 0); border-right-color: rgba(55, 55, 55, 0); border-top-color: rgba(55, 55, 55, 0); border-bottom-color: rgba(55, 55, 55, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/GameUIs/pixilart-drawing.png?fileID=2800000&amp;guid=5681fba2d4ea6094f946a9f7f27d6595&amp;type=3#pixilart-drawing&quot;); background-color: rgba(188, 188, 188, 0); background-size: 100% 100%;"/>
        <ui:VisualElement name="ReceptionLockPanel" style="flex-grow: 1; position: absolute; top: auto; left: auto; right: auto; bottom: auto; align-items: center; justify-content: center; align-self: center; align-content: center; width: 900px; height: 600px; display: none;">
            <ui:TextField label="" placeholder-text="Enter Code" name="CodeInput" max-length="4" password="false" style="font-size: 28px;"/>
            <ui:Button text="Unlock" name="SumitCodeButton" style="font-size: 28px;"/>
            <ui:Button text="X" name="CloseLockBtn" style="top: 8px; right: 8px; position: absolute; width: 24px; height: 24px; background-color: rgb(188, 188, 188); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);"/>
        </ui:VisualElement>
        <ui:VisualElement name="ClueAPanel" style="flex-grow: 1; position: absolute; width: 800px; height: 400px; align-items: center; justify-content: center; align-self: center; align-content: center; background-image: url(&quot;project://database/Assets/GameUIs/pixil-frame-0%20(3).png?fileID=2800000&amp;guid=fed16cd4c201b46418c628352188852e&amp;type=3#pixil-frame-0 (3)&quot;); display: none;">
            <ui:Label text="&quot;Three guests arrived when the hotel feared,&#10;On the same day, though different months appeared.&#10;Remember the earliest, let time be your guide,&#10;Their room numbers in order shall unlock what’s inside.&#10;&#10;But beware the book, for truth may deceive,&#10;And three marks the end of what you must retrieve.&quot;" emoji-fallback-support="true" style="position: absolute; top: auto; left: auto; right: auto; bottom: auto; align-items: auto; justify-content: flex-start; align-self: auto; align-content: auto; background-size: 90% 100%; font-size: 24px; -unity-font-definition: url(&quot;project://database/Assets/Text%20fonts/IndieFlower-Regular.ttf?fileID=12800000&amp;guid=2dc1a6d7df903c347ac0a8ba911439b6&amp;type=3#IndieFlower-Regular&quot;); -unity-font-style: bold;"/>
            <ui:Button text="X" parse-escape-sequences="true" name="CloseClueABtn" style="position: absolute; top: 8px; right: 8px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);"/>
        </ui:VisualElement>
        <ui:VisualElement name="ClueBPanel" style="flex-grow: 1; position: absolute; width: 800px; height: 400px; align-items: center; justify-content: center; align-self: center; align-content: center; background-image: url(&quot;project://database/Assets/GameUIs/pixil-frame-0%20(3).png?fileID=2800000&amp;guid=fed16cd4c201b46418c628352188852e&amp;type=3#pixil-frame-0 (3)&quot;); display: none; font-size: 28px;">
            <ui:Label text="Guest&#x9;&#x9;Check-in&#x9;&#x9;Room&#10;Allen&#x9;&#x9;Jan 12&#x9;&#x9;   &#x9;02&#10;Rose&#x9;&#x9;Jan 13&#x9;&#x9;   &#x9;04&#10;Henry&#x9;&#x9;Feb 13&#x9;&#x9;   &#x9;07&#10;Clara&#x9;&#x9;Mar 13&#x9;&#x9;   &#x9;10&#10;James&#x9;&#x9;Mar 15&#x9;           &#x9;05" enable-rich-text="true" style="align-items: auto; justify-content: flex-start; align-self: auto; align-content: auto; -unity-font-definition: url(&quot;project://database/Assets/Text%20fonts/IndieFlower-Regular.ttf?fileID=12800000&amp;guid=2dc1a6d7df903c347ac0a8ba911439b6&amp;type=3#IndieFlower-Regular&quot;); -unity-font-style: bold;"/>
            <ui:Button text="X" parse-escape-sequences="true" name="CloseClueBBtn" style="position: absolute; top: 8px; right: 8px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);"/>
        </ui:VisualElement>
        <ui:VisualElement name="ClueCPanel" style="flex-grow: 1; position: absolute; width: 800px; height: 200px; align-items: center; justify-content: center; align-self: center; align-content: center; background-image: url(&quot;project://database/Assets/GameUIs/pixil-frame-0%20(3).png?fileID=2800000&amp;guid=fed16cd4c201b46418c628352188852e&amp;type=3#pixil-frame-0 (3)&quot;); display: none; font-size: 28px;">
            <ui:Label text="The 13th of every month is marked &#10;with a red star." style="align-items: auto; justify-content: flex-start; align-self: auto; align-content: auto; -unity-font-definition: url(&quot;project://database/Assets/Text%20fonts/IndieFlower-Regular.ttf?fileID=12800000&amp;guid=2dc1a6d7df903c347ac0a8ba911439b6&amp;type=3#IndieFlower-Regular&quot;); font-size: 32px; -unity-font-style: bold;"/>
            <ui:Button text="X" parse-escape-sequences="true" name="CloseClueCBtn" style="position: absolute; top: 8px; right: 8px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
